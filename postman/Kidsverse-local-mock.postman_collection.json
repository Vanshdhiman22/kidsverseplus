              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Local mock only\", () => pm.expect(pm.response.headers.get(\"X-Kidsverse-Source\")).to.equal(\"local-mock\"));",
              "pm.test(\"Not a DB test\", () => pm.expect(pm.response.json().status).to.equal(\"not_tested\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Signup dummy parent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/parent/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"MockPass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email\", `postman.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Local mock only\", () => pm.expect(pm.response.headers.get(\"X-Kidsverse-Source\")).to.equal(\"local-mock\"));",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
