{
  "info": {
    "name": "Kidsverse local mock — sequential integration tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local mock ONLY. Start frontend Vite on port 5180. This is not the senior's exported collection and does not test a production DB. Uses dummy accounts in memory. Run in listed order; five test questions belong to the bundled maths fixture."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5180/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Mock health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Local mock only\", () => pm.expect(pm.response.headers.get(\"X-Kidsverse-Source\")).to.equal(\"local-mock\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Database explicitly NOT tested",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
